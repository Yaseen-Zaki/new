<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <EditTextPreference
        android:key="interval_ms"
        android:title="@string/pref_interval_title"
        android:summary="@string/pref_interval_summary"
        android:dialogTitle="@string/pref_interval_dialog"
        android:dialogMessage="@string/pref_interval_hint_seconds" />

    <EditTextPreference
        android:key="worker_token"
        android:title="@string/pref_token_title"
        android:summary="@string/pref_token_summary"
        android:dialogTitle="@string/pref_token_dialog" />

    <Preference
        android:key="folder_display"
        android:title="@string/pref_folder_title"
        android:summary="@string/pref_folder_none"
        android:persistent="false" />

    <Preference
        android:key="sync_status"
        android:title="@string/pref_status_title"
        android:summary="@string/pref_status_unknown"
        android:persistent="false"
        android:selectable="false" />

</PreferenceScreen>
